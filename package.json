{
  "name": "tinypine",
  "version": "1.0.0",
  "description": "Minimal, comfortable & intuitive reactive micro-framework",
  "main": "src/core.js",
  "types": "types/tinypine.d.ts",
  "type": "module",
  "scripts": {
    "dev": "npx serve -p 8000",
    "serve": "npx serve -p 8000",
    "demo": "npx serve -p 8000 -o demo/index.html",
    "build": "node build.cjs",
    "minify": "npm run build",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "reactive",
    "framework",
    "micro-framework",
    "vanilla-js",
    "dom",
    "reactivity"
  ],
  "author": "TinyPine Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DigitalCoreHub/TinyPine.git"
  },
  "files": [
    "src/",
    "dist/",
    "types/",
    "README.md"
  ],
  "devDependencies": {
    "terser": "^5.44.0",
    "vitest": "^1.2.0"
  }
}
